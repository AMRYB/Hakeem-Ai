# ---------- App ----------
APP_ENV=development
APP_NAME=Grounded DDI Assistant
SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRE_MINUTES=1440
PROFILE_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
ALLOWED_ORIGINS=http://localhost:3000

# Local default. For Vercel set a Postgres URL (Neon/Supabase/etc.).
DATABASE_URL=sqlite:///./ddi_app.db

# ---------- RAG store ----------
# auto => Chroma when SQLite, pgvector when PostgreSQL
RAG_STORE=auto
CHROMA_DIR=./chroma_db
DENSE_TOP_K=20
SPARSE_TOP_K=20
FINAL_TOP_K=8
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_THRESHOLD=0.15

# Embeddings: sentence_transformers or ollama
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=pritamdeka/S-PubMedBert-MS-MARCO
EMBEDDING_BATCH_SIZE=32

# ---------- LLM ----------
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5:latest
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120

# ---------- FDA fallback ----------
FDA_API_BASE=https://api.fda.gov
FDA_API_KEY=
FDA_TIMEOUT_SECONDS=15

# ---------- Data ----------
EDA_MONOGRAPHS_CSV=./data/egypt/eda_all_drug_monographs.csv
EDA_MONOGRAPHS_CLEANED_CSV=./data/egypt/eda_all_drug_monographs_cleaned.csv
DRUG_ALIASES_CSV=./data/aliases/drug_aliases.csv
DDINTER_GLOB=./data/ddinter/ddinter_downloads_code_*.csv
FORMULARY_DIR=./data/formulary
SAFETY_PATTERNS_FILE=./config/safety_patterns.json

# ---------- Frontend (put in .env.local for Next.js) ----------
# Empty means same origin (/api) on Vercel.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
